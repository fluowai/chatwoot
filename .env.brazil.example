# ==============================================================================
# CONFIGURAÇÃO PADRÃO - CHATWOOT ENTERPRISE EDIÇÃO BRASIL (SELF-HOSTED)
# ==============================================================================

# Chave secreta do Rails (gere uma string hexadecimal segura de 64+ caracteres)
SECRET_KEY_BASE=gere_uma_chave_secreta_hexadecimal_longa_aqui_64_chars

# URL pública do sistema (com https:// quando publicado atrás de proxy reverso)
FRONTEND_URL=https://atendimento.suaempresa.com.br
FORCE_SSL=true

# Edição, Idioma e Fuso Horário Padrão Brasil
CW_EDITION=ee
DEFAULT_LOCALE=pt_BR
DEFAULT_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
DISABLE_TELEMETRY=true
AUTO_MIGRATE=true
ENABLE_ACCOUNT_SIGNUP=false

# Banco de Dados PostgreSQL (pgvector:pg16)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=troque_por_senha_forte_postgres

# Cache e Filas Redis
REDIS_URL=redis://:troque_por_senha_forte_redis@redis:6379/0
REDIS_PASSWORD=troque_por_senha_forte_redis

# Performance Puma / Sidekiq
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# WhatsApp Não Oficial (Evolution API / Baileys / Whatsmeow)
EVOLUTION_API_HOST=http://evolution-api:8080
EVOLUTION_API_KEY=troque_por_sua_global_api_key
# BAILEYS_GATEWAY_URL=http://baileys-gateway:8082
# WHATSMEOW_BRIDGE_URL=http://whatsmeow-bridge:8083

# Transcrição Automática de Áudios de WhatsApp (Whisper PT-BR)
# Preencha GROQ_API_KEY (recomendado - ultra rápido) ou OPENAI_API_KEY
GROQ_API_KEY=
OPENAI_API_KEY=

# Dados Padrão de Cobrança PIX (opcional - editável também na UI e Super Admin)
PIX_DEFAULT_KEY=
PIX_MERCHANT_NAME=MINHA EMPRESA LTDA
PIX_MERCHANT_CITY=SAO PAULO

# E-mail Transacional (SMTP)
MAILER_SENDER_EMAIL=Atendimento <atendimento@suaempresa.com.br>
SMTP_DOMAIN=suaempresa.com.br
SMTP_ADDRESS=smtp.suaempresa.com.br
SMTP_PORT=587
SMTP_USERNAME=atendimento@suaempresa.com.br
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
